# GardenAI MVP - Environment Variables
# Run with: op run --env-file=.env -- streamlit run app.py
# Never put raw API keys here. Use 1Password op:// references only.

# Google Gemini API
GEMINI_API_KEY=op://Dev/LLM API/gemini-gardenai-mvp

# Model selection
GEMINI_MODEL_PRIMARY=gemini-3.1-flash-lite
GEMINI_MODEL_PREMIUM=gemini-3.1-pro-preview
GEMINI_MODEL_VISION=gemini-3.1-flash-image-preview

# Database (W1-W2 用 SQLite，W3+ 切 Postgres)
DATABASE_URL=sqlite:///data/partners/dev.db

# Streamlit auth (W1-W2 用簡單密碼)
ADMIN_PASSWORD=changeme-on-first-run

# Marketplace defaults
DEFAULT_MARKETPLACE=DE
DEFAULT_LOCALE=de-DE

# Logging
LOG_LEVEL=INFO

# DeepSeek (W7+ 才用，先放這裡備忘)
# DEEPSEEK_API_KEY=op://Dev/LLM API/Deepseek-hermes agent
